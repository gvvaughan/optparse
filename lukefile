luke_format = 0

package  = 'optparse'
version  = '$USER'

-- LuaRocks builds the modules from the rockspec, which is how `luke release`
-- builds them too, so what is left is for `luke`, to build the LDocs, and
-- for `luke release`.
ldocs    = 'build-aux/config.ld.in'

release  = {
   news               = 'NEWS.md',
   rockspec           = 'optparse-dev-1.rockspec',
   check_dependencies = true,
   add                = {'doc/api/'},
   replacements       = {
      {['README.md']  = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages']       = {
      {api          = 'doc/api/'},
      {['index.md'] = 'doc/optparse.md'},
      '_config.yml.in',
   },
}
