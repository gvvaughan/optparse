luke_format = 0

package  = 'optparse'
version  = '$USER'

ldocs    = 'build-aux/config.ld.in'

modules  = {
   {['optparse']         = 'lib/optparse/init.lua'},
   {['optparse._strict'] = 'lib/optparse/_strict.lua'},
   {['optparse.version'] = 'lib/optparse/version.lua.in'},
}

release  = {
   news               = 'NEWS.md',
   rockspec           = 'optparse-dev-1.rockspec',
   check_dependencies = true,
   add                = {'doc/api/'},
   replacements       = {
      {['README.md']  = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   ['gh-pages']       = {
      {api          = 'doc/api/'},
      {['index.md'] = 'doc/optparse.md'},
      '_config.yml.in',
   },
}
